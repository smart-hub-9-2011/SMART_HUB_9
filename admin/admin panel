async function loadContent(){const sel=chosen();if(!sel)return status('contentStatus','Choose class, subject, and chapter first.');status('contentStatus','Loading…',true);const {data,error}=await db.from('study_content').select('id,title,body,updated_at').match(sel).maybeSingle();if(error)return status('contentStatus','Load failed: '+error.message);$('contentTitle').value=data?.title||sel.chapter+' — '+({'notes':'Notes','ncert':'Questions & Answers','schand':'Extra Questions & Answers','notespdf':'Notes PDF'}[sel.content_type]);$('contentBody').value=sel.content_type==='notespdf'?'':(data?.body||'');$('contentPdf').value='';$('pdfCurrentStatus').textContent=sel.content_type==='notespdf'?(data?.body?'A PDF is already saved for this chapter. Upload another PDF to replace it.':'No PDF uploaded for this chapter yet.') : '';typeChanged();status('contentStatus',data?'Saved content loaded. Last updated: '+new Date(data.updated_at).toLocaleString():'No saved content exists yet for this material type. Add content and save.',true)}
async function saveContent(){const sel=chosen();if(!sel)return status('contentStatus','Choose class, subject, and chapter first.');const title=$('contentTitle').value.trim()||(sel.content_type==='notespdf'?sel.chapter+' — Notes PDF':'');let body=$('contentBody').value.trim();let oldPath=null;if(sel.content_type==='notespdf'){const file=$('contentPdf').files[0];if(!file)return status('contentStatus','Choose a PDF file before saving.');if(file.type!=='application/pdf'&&!file.name.toLowerCase().endsWith('.pdf'))return status('contentStatus','Only PDF files are accepted.');if(file.size>30*1024*1024)return status('contentStatus','PDF must be 30 MB or smaller.');const prior=await db.from('study_content').select('body').match(sel).maybeSingle();oldPath=prior.data?.body||null;const safe=s=>String(s).normalize('NFKD').replace(/[^a-zA-Z0-9_-]+/g,'-').replace(/^-+|-+$/g,'').slice(0,70)||'item';const path=`${sel.class_level}/${safe(sel.subject)}/${safe(sel.chapter)}/${Date.now()}-${safe(file.name.replace(/\.pdf$/i,''))}.pdf`;status('contentStatus','Uploading PDF…',true);const {error:uploadError}=await db.storage.from('smarthub-notes-pdfs').upload(path,file,{contentType:'application/pdf',upsert:false});if(uploadError)return status('contentStatus','PDF upload failed: '+uploadError.message);body=path;}else{if(!title||!body)return status('contentStatus','Title and content are required.');status('contentStatus','Saving…',true)}const {error}=await db.rpc('admin_upsert_study_content',{p_id:null,p_class_level:sel.class_level,p_subject:sel.subject,p_chapter:sel.chapter,p_content_type:sel.content_type,p_title:title,p_body:body});if(error){if(sel.content_type==='notespdf')await db.storage.from('smarthub-notes-pdfs').remove([body]);return status('contentStatus','Save failed: '+error.message+' — check the Supabase SQL setup for the Notes PDF material type.')}if(sel.content_type==='notespdf'){$('contentPdf').value='';$('pdfCurrentStatus').textContent='PDF uploaded and linked to this chapter.';if(oldPath&&oldPath!==body)await db.storage.from('smarthub-notes-pdfs').remove([oldPath]);}status('contentStatus','Saved successfully. Refresh the public website to see the updated material.',true);const {count}=await db.from('study_content').select('*',{count:'exact',head:true});$('contentCount').textContent=count??'—'}
