let adminSuggestions=[];
async function loadAdminSuggestions(){
  const box=$('adminSuggestionList');
  if(!box)return;
  box.innerHTML='<p class="muted">Loading suggestions…</p>';
  status('suggestionAdminStatus','Loading suggestions…',true);
  const {data,error}=await db.from('suggestions')
    .select('id,name,text,likes,dislikes,created_at,approved')
    .order('created_at',{ascending:false}).limit(300);
  if(error){
    box.innerHTML='<p class="muted">Could not load suggestions.</p>';
    return status('suggestionAdminStatus','Could not load suggestions: '+error.message+' — check the suggestions table SELECT policy for admins.',false);
  }
  adminSuggestions=data||[];
  renderAdminSuggestions();
  const visible=adminSuggestions.filter(x=>x.approved===true).length;
  status('suggestionAdminStatus',`${adminSuggestions.length} suggestion(s) loaded · ${visible} visible on the public website.`,true);
}
function renderAdminSuggestions(){
  const box=$('adminSuggestionList');
  if(!box)return;
  const filter=$('suggestionFilter')?.value||'all';
  const term=($('suggestionSearch')?.value||'').trim().toLowerCase();
  const items=adminSuggestions.filter(x=>{
    const state=filter==='all'||(filter==='approved'&&x.approved===true)||(filter==='hidden'&&x.approved!==true);
    return state&&(!term||String(x.text||'').toLowerCase().includes(term)||String(x.name||'').toLowerCase().includes(term));
  });
  if(!items.length){box.innerHTML='<p class="muted">No matching suggestions.</p>';return;}
  box.innerHTML=items.map(x=>`<div class="item">
    <div class="admin-suggestion-copy">
      <div class="admin-suggestion-meta"><strong>${esc(x.name||'Anonymous')}</strong><span>${x.created_at?esc(new Date(x.created_at).toLocaleString()):'Date unavailable'}</span><span class="admin-state">${x.approved===true?'Visible':'Hidden'}</span></div>
      <div class="suggestion-text">${esc(x.text||'')}</div>
      <div class="admin-suggestion-meta"><span>👍 ${Number(x.likes)||0}</span><span>👎 ${Number(x.dislikes)||0}</span><span>ID: ${esc(x.id)}</span></div>
    </div>
    <div class="admin-suggestion-actions">
      <button type="button" data-suggestion-action="edit" data-suggestion-id="${esc(x.id)}">Edit</button>
      <button type="button" data-suggestion-action="visibility" data-suggestion-id="${esc(x.id)}">${x.approved===true?'Hide':'Restore'}</button>
      <button type="button" class="danger" data-suggestion-action="delete" data-suggestion-id="${esc(x.id)}">Delete</button>
    </div>
  </div>`).join('');
}
// Use delegated click handling so dynamically rendered action buttons always work.
(function attachSuggestionActionHandler(){
  const box=$('adminSuggestionList');
  if(!box || box.dataset.actionsBound==='yes')return;
  box.dataset.actionsBound='yes';
  box.addEventListener('click',async(event)=>{
    const button=event.target.closest('button[data-suggestion-action]');
    if(!button || !box.contains(button))return;
    const id=button.dataset.suggestionId;
    const action=button.dataset.suggestionAction;
    button.disabled=true;
    try{
      if(action==='edit')await editAdminSuggestion(id);
      else if(action==='visibility'){
        const item=adminSuggestions.find(x=>String(x.id)===String(id));
        if(item)await setSuggestionVisibility(id,item.approved!==true);
      }else if(action==='delete')await deleteAdminSuggestion(id);
    }catch(error){
      console.error('Suggestion action failed:',error);
      status('suggestionAdminStatus','Action failed: '+(error?.message||String(error)),false);
    }finally{
      button.disabled=false;
    }
  });
})();

async function editAdminSuggestion(id){
  const item=adminSuggestions.find(x=>String(x.id)===String(id));
  if(!item)return status('suggestionAdminStatus','Could not find this suggestion. Refresh and try again.',false);
  const name=prompt('Student name (or Anonymous):',item.name||'Anonymous');
  if(name===null)return;
  const suggestion=prompt('Edit suggestion:',item.text||'');
  if(suggestion===null)return;
  if(!suggestion.trim())return status('suggestionAdminStatus','Suggestion text cannot be empty.',false);
  status('suggestionAdminStatus','Saving changes…',true);
  const {data,error}=await db.from('suggestions')
    .update({name:name.trim().slice(0,60)||'Anonymous',text:suggestion.trim().slice(0,1000)})
    .eq('id',item.id).select('id');
  if(error)return status('suggestionAdminStatus','Could not edit suggestion: '+error.message,false);
  if(!data||data.length===0)return status('suggestionAdminStatus','No row was updated. Check that the admin UPDATE policy exists, allows your account, and that this suggestion ID still exists.',false);
  await loadAdminSuggestions();
  status('suggestionAdminStatus','Suggestion updated successfully.',true);
}
async function setSuggestionVisibility(id,approved){
  const item=adminSuggestions.find(x=>String(x.id)===String(id));
  if(!item)return status('suggestionAdminStatus','Could not find this suggestion. Refresh and try again.',false);
  status('suggestionAdminStatus',approved?'Restoring suggestion…':'Hiding suggestion…',true);
  const {data,error}=await db.from('suggestions')
    .update({approved})
    .eq('id',item.id).select('id');
  if(error)return status('suggestionAdminStatus','Could not change visibility: '+error.message,false);
  if(!data||data.length===0)return status('suggestionAdminStatus','No row was updated. Check that the admin UPDATE policy exists, allows your account, and that this suggestion ID still exists.',false);
  await loadAdminSuggestions();
  status('suggestionAdminStatus',approved?'Suggestion restored and visible on the website.':'Suggestion hidden from the public website.',true);
}
async function deleteAdminSuggestion(id){
  const item=adminSuggestions.find(x=>String(x.id)===String(id));
  if(!item)return status('suggestionAdminStatus','Could not find this suggestion. Refresh and try again.',false);
  if(!confirm('Permanently delete this suggestion? This cannot be undone.'))return;
  status('suggestionAdminStatus','Deleting suggestion…',true);
  const {data,error}=await db.from('suggestions')
    .delete().eq('id',item.id).select('id');
  if(error)return status('suggestionAdminStatus','Could not delete suggestion: '+error.message,false);
  if(!data||data.length===0)return status('suggestionAdminStatus','No row was deleted. Check that the admin DELETE policy exists, allows your account, and that this suggestion ID still exists.',false);
  await loadAdminSuggestions();
  status('suggestionAdminStatus','Suggestion permanently deleted.',true);
}

function renderOverview(){const box=$('structureOverview');if(!rows.length){box.innerHTML='<p class="muted">No structure found. Add a class to begin.</p>';return}box.innerHTML=classes().map(([cls,label])=>{const subs=subjectsFor(cls);return `<div class="item"><div><div class="name">${esc(label)} <small>Class level ${cls}</small></div><small>${subs.length} subject(s) · ${subs.reduce((n,s)=>n+chaptersFor(cls,s).length,0)} chapter(s)</small></div><button onclick="manageOverviewClass(${Number(cls)})">Manage</button></div>`}).join('')}
(async()=>{const {data}=await db.auth.getSession();if(data?.session){user=data.session.user;await authorize()}db.auth.onAuthStateChange((event,session)=>{if(event==='SIGNED_OUT'){user=null}})})();
