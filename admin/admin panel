/* Premium SmartHub Admin visual layer */
:root{color-scheme:dark;--bg:#070b18;--panel:#10182b;--panel2:#151f37;--line:#2a3654;--text:#f4f6ff;--muted:#a8b3cf;--blue:#7ab8ff;--purple:#b39aff;--green:#5ee5b0;--red:#ff8398;--yellow:#ffd780}
body{background:radial-gradient(ellipse at 8% -8%,rgba(83,112,255,.24),transparent 38%),radial-gradient(ellipse at 100% 12%,rgba(175,93,255,.15),transparent 30%),#070b18;min-height:100vh}
.wrap{max-width:1440px;padding:28px clamp(14px,3vw,42px) 48px}
.top{padding:16px 20px;border:1px solid rgba(145,164,220,.18);background:rgba(14,22,41,.72);backdrop-filter:blur(18px);border-radius:22px;box-shadow:0 18px 50px #0003;margin-bottom:24px;position:sticky;top:10px;z-index:5}
.logo{width:52px;height:52px;border-radius:17px;background:linear-gradient(135deg,#4b9cff,#8b5cf6 70%,#d17dff);box-shadow:0 8px 28px #775cf355;font-size:26px}
.brand h1{font-size:23px;letter-spacing:-.6px}.brand p{font-size:12px;letter-spacing:.25px}
.card{background:linear-gradient(145deg,rgba(20,31,55,.96),rgba(12,19,36,.96));border:1px solid rgba(143,164,216,.18);border-radius:22px;padding:clamp(16px,2vw,26px);box-shadow:0 18px 60px rgba(0,0,0,.22);transition:border-color .2s,transform .2s}
.card:hover{border-color:rgba(122,184,255,.3)}
.login{margin:8vh auto;padding:clamp(24px,4vw,38px);border-radius:28px;position:relative;overflow:hidden}
.login:before{content:"✦  ✧  ✦";display:block;color:#a9a1ff;letter-spacing:14px;font-size:14px;margin-bottom:18px}
.login h2{font-size:27px;letter-spacing:-.7px}.subhead{line-height:1.7}
input,select,textarea{background:rgba(5,11,24,.72);border-color:#2a3858;border-radius:12px;padding:12px 13px;transition:box-shadow .18s,border-color .18s}
input:focus,select:focus,textarea:focus{border-color:#8a9fff;box-shadow:0 0 0 4px rgba(111,137,255,.13)}
button{border-radius:12px;padding:10px 14px;transition:transform .15s,filter .15s,border-color .15s}
button:hover{transform:translateY(-1px)}button:active{transform:translateY(0)}
button.primary{background:linear-gradient(120deg,#3988ff,#7857ef 75%,#9e62e9);box-shadow:0 8px 22px #654ff033}
button.danger{background:rgba(105,30,54,.25);border-color:rgba(255,110,143,.3)}
.counts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:0 0 20px}
.count{position:relative;overflow:hidden;min-width:0;padding:18px;border-radius:18px;background:linear-gradient(140deg,rgba(24,37,65,.9),rgba(13,22,41,.9));border-color:rgba(138,160,220,.18)}
.count:after{content:"";position:absolute;width:80px;height:80px;right:-25px;top:-30px;border-radius:50%;background:rgba(123,151,255,.08)}
.count strong{font-size:30px;letter-spacing:-1px}.count span{font-size:12px;letter-spacing:.3px}
.grid{gap:18px}.sectionhead{align-items:flex-start}.sectionhead h2,.card h2{font-size:19px;letter-spacing:-.35px}
.pill{border-color:rgba(124,170,255,.25);background:rgba(70,125,221,.1);color:#c9ddff;padding:5px 10px}
.item{background:rgba(6,13,27,.48);border-color:rgba(139,160,211,.16);border-radius:14px;padding:13px}
.tabs{padding:5px;background:rgba(3,8,19,.45);border:1px solid rgba(139,160,211,.14);border-radius:15px}
.tab{border-color:transparent}.tab.active{background:linear-gradient(120deg,rgba(57,136,255,.22),rgba(120,87,239,.22));border-color:rgba(122,184,255,.36)}
.warning{border-color:rgba(255,211,120,.25);background:rgba(109,78,21,.17);color:#ffe4aa;border-radius:15px;line-height:1.65}
.status{line-height:1.6}.status.good{color:#75efbd}.status.bad{color:#ff9bab}
.editor{min-height:360px;line-height:1.75}
hr{opacity:.65}
#dashboard>.grid{align-items:start}
#structureOverview{max-height:360px;overflow:auto;padding-right:3px}
@media(max-width:800px){.top{position:static;padding:13px}.counts{grid-template-columns:repeat(2,minmax(0,1fr))}.count strong{font-size:25px}.sectionhead{flex-wrap:wrap}.editor{min-height:260px}}
@media(max-width:420px){.brand h1{font-size:19px}.brand p{max-width:230px}.counts{gap:8px}.count{padding:13px}}


/* S.S PUBLIC SCHOOL identity — aligned with the public SmartHub website */
:root{
  --bg:#080d0a;--panel:#141912;--panel2:#1b2419;--line:rgba(204,169,94,.24);
  --text:#f7f3e8;--muted:#c2bcae;--blue:#d8b45d;--purple:#7acb98;
  --green:#65d59a;--red:#ff8390;--yellow:#e5c16f;
}
body{
  background:
    radial-gradient(ellipse at 12% 0%,rgba(201,164,90,.13),transparent 36%),
    radial-gradient(ellipse at 88% 10%,rgba(39,130,79,.16),transparent 34%),
    #080d0a;
  color:var(--text);font-family:Inter,Segoe UI,Arial,sans-serif;
}
.school-header{
  position:relative;isolation:isolate;overflow:hidden;
  padding:28px clamp(16px,4vw,58px);
  border-bottom:1px solid rgba(204,169,94,.3);
  background:
    radial-gradient(ellipse at 70% 110%,rgba(39,83,97,.24),transparent 46%),
    linear-gradient(90deg,rgba(7,14,27,.22),rgba(17,25,43,.38) 47%,rgba(33,30,28,.06));
}
.school-inner{
  position:relative;z-index:1;max-width:1440px;min-height:152px;margin:auto;
  display:flex;align-items:center;gap:25px;
}
.school-photo{
  width:132px;height:116px;object-fit:cover;border-radius:22px;flex:none;
  border:1px solid rgba(214,180,98,.62);
  box-shadow:0 14px 42px rgba(0,0,0,.48),0 0 24px rgba(196,151,62,.13);
}
.school-text{flex:1;min-width:0}
.school-text small{display:block;color:#79c995;letter-spacing:3.5px;font-size:11px;font-weight:800;margin-bottom:7px}
.school-text h1{font-family:Georgia,'Times New Roman',serif;font-size:clamp(27px,3.2vw,42px);line-height:1.1;letter-spacing:.2px;margin:0 0 10px}
.school-text h1 span{color:#d8b45d}
.school-details{color:#e4dfd2;font-size:14px;line-height:1.65}
.school-badge{
  padding:16px 24px;border:1px solid rgba(211,174,91,.48);
  background:rgba(13,16,12,.62);backdrop-filter:blur(16px);border-radius:18px;
  text-align:center;box-shadow:0 8px 30px rgba(0,0,0,.25);flex:none;
}
.school-badge strong{display:block;font-size:25px;color:#e3c16f}
.school-badge span{font-size:12px;color:#e4dfd2}
.wrap{max-width:1500px;padding:24px clamp(14px,3vw,42px) 48px}
.top{
  position:relative;top:auto;margin-bottom:22px;padding:14px 19px;
  border:1px solid rgba(204,169,94,.22);border-radius:18px;
  background:rgba(13,18,13,.82);box-shadow:0 14px 38px rgba(0,0,0,.22);
  backdrop-filter:blur(16px)
}
.logo{background:linear-gradient(135deg,#b98a37,#246b45);box-shadow:0 8px 25px rgba(151,117,48,.25)}
.brand h1{font-family:Georgia,'Times New Roman',serif;letter-spacing:.1px}
.brand h1 span{color:#d8b45d!important}
.card{
  background:linear-gradient(145deg,rgba(25,31,23,.97),rgba(14,20,15,.97));
  border:1px solid rgba(204,169,94,.2);border-radius:20px;
  box-shadow:0 18px 48px rgba(0,0,0,.24);transition:border-color .2s,box-shadow .2s
}
.card:hover{border-color:rgba(214,180,98,.4);box-shadow:0 20px 52px rgba(0,0,0,.28)}
.login:before{color:#d8b45d}
input,select,textarea{background:rgba(5,10,7,.72);border-color:rgba(204,169,94,.23);color:var(--text)}
input:focus,select:focus,textarea:focus{border-color:#cda957;box-shadow:0 0 0 3px rgba(205,169,87,.13)}
button{background:rgba(255,255,255,.055);border-color:rgba(204,169,94,.2);color:var(--text)}
button:hover{border-color:rgba(216,180,93,.65);filter:brightness(1.08)}
button.primary{background:linear-gradient(120deg,#9a7130,#276b46);box-shadow:0 8px 22px rgba(86,112,57,.2)}
button.danger{background:rgba(105,30,54,.22);border-color:rgba(255,110,143,.3)}
.count{background:linear-gradient(140deg,rgba(40,49,31,.92),rgba(17,25,17,.94));border-color:rgba(204,169,94,.2)}
.count:after{background:rgba(211,174,91,.1)}
.pill{border-color:rgba(211,174,91,.28);background:rgba(164,123,43,.12);color:#ead8aa}
.item{background:rgba(5,11,7,.46);border-color:rgba(204,169,94,.17)}
.tabs{background:rgba(3,8,5,.42);border-color:rgba(204,169,94,.16)}
.tab{background:transparent}.tab.active{background:linear-gradient(120deg,rgba(164,123,43,.22),rgba(34,111,70,.2));border-color:rgba(210,174,94,.4)}
.warning{border-color:rgba(211,174,91,.28);background:rgba(109,78,21,.14);color:#f1dfb4}
.status.good{color:#75dfaa}.status.bad{color:#ff9bab}
hr{border-color:rgba(204,169,94,.2)!important}
#dashboard>section:first-child{
  background:
    radial-gradient(ellipse at 82% 18%,rgba(193,148,55,.17),transparent 34%),
    radial-gradient(ellipse at 14% 92%,rgba(31,117,70,.2),transparent 38%),
    linear-gradient(125deg,#090b09 0%,#171912 53%,#0b1c13 100%)!important;
  border-color:rgba(203,165,83,.34)
}
#structureOverview{scrollbar-color:#9c8046 #101710}
@media(max-width:750px){
  .school-header{padding:22px 5%}
  .school-inner{gap:15px;flex-wrap:wrap}
  .school-photo{width:108px;height:98px;border-radius:18px}
  .school-text{flex:1 1 calc(100% - 125px)}
  .school-text small{letter-spacing:1.5px;font-size:10px}
  .school-text h1{font-size:clamp(23px,5.5vw,30px)}
  .school-details{font-size:13px}
  .school-badge{display:block;margin-left:123px;padding:9px 15px}
}
@media(max-width:420px){
  .school-photo{width:92px;height:88px}
  .school-text{flex-basis:calc(100% - 108px)}
  .school-text h1{font-size:22px}
  .school-badge{margin-left:107px}
}


/* Admin suggestion moderation */
#adminSuggestionList .item{align-items:flex-start;gap:16px}
.admin-suggestion-copy{min-width:0;flex:1}
.admin-suggestion-copy .suggestion-text{white-space:pre-wrap;overflow-wrap:anywhere;margin:7px 0;color:var(--text)}
.admin-suggestion-meta{font-size:12px;color:var(--muted);display:flex;gap:10px;flex-wrap:wrap}
.admin-suggestion-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.admin-suggestion-actions button{font-size:12px;padding:8px 11px}
.admin-suggestion-actions .danger{border-color:rgba(190,75,75,.55)}
.admin-state{font-size:11px;border:1px solid var(--line);border-radius:99px;padding:3px 8px}
@media(max-width:650px){#adminSuggestionList .item{flex-direction:column}.admin-suggestion-actions{justify-content:flex-start}}
</style></head><body>
<header class="school-header">
  <div class="school-inner">
    <img class="school-photo" src="data:image/png;base64," alt="S.S PUBLIC SCHOOL">
    <div class="school-text">
      <small>WELCOME TO OUR SCHOOL</small>
      <h1>S.S <span>PUBLIC SCHOOL</span></h1>
      <div class="school-details">
        <strong>By Sanjay Singh</strong><br>
        Dighwa Dubauli, Gopalganj, Bihar<br>
        <strong>10+2 School</strong>
      </div>
    </div>
    <div class="school-badge"><strong>10+2</strong><span>School</span></div>
  </div>
</header>
<div class="wrap">
<header class="top"><div class="brand"><div class="logo">✦</div><div><h1>SmartHub <span style="color:var(--blue)">Admin</span></h1><p>Study structure · text notes · chapter PDF library</p></div></div><button id="logoutBtn" class="hidden" onclick="logout()">Sign out</button></header>
<section id="loginCard" class="card login"><h2>Administrator sign in</h2><p class="subhead">Sign in with a Supabase Auth account that has been added to the SmartHub admins list.</p><div class="field"><label for="email">Email</label><input id="email" type="email" autocomplete="username" placeholder="admin@example.com"></div><div class="field" style="margin-top:12px"><label for="password">Password</label><input id="password" type="password" autocomplete="current-password" placeholder="Your password"></div><div class="actions"><button class="primary" style="width:100%" onclick="login()">Sign in securely</button></div><div id="loginStatus" class="status"></div></section>
<main id="dashboard" class="hidden"><section class="card" style="margin-bottom:20px;background:linear-gradient(115deg,rgba(43,91,169,.25),rgba(93,64,168,.2) 55%,rgba(20,31,55,.85));position:relative;overflow:hidden"><div style="display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap"><div><div class="pill" style="display:inline-flex;margin-bottom:10px">✦ CONTENT CONTROL CENTER</div><h2 style="font-size:clamp(24px,3vw,34px);letter-spacing:-1px;margin:0 0 7px">Build your learning world.</h2><p class="subhead" style="max-width:720px;margin:0">Manage your complete class → subject → chapter structure, publish text materials and upload chapter-specific PDF notes from one place.</p></div><div style="font-size:54px;filter:drop-shadow(0 10px 20px #0004)" aria-hidden="true">📚</div></div></section><div class="warning">This panel manages study classes, subjects, chapters, text Notes, Questions &amp; Answers, Extra Questions &amp; Answers, and chapter Notes PDFs. Do not put a Supabase service-role/secret key here. Use the publishable/anon key only.</div>
<div class="counts"><div class="count"><strong id="classCount">—</strong><span>Classes</span></div><div class="count"><strong id="subjectCount">—</strong><span>Subjects</span></div><div class="count"><strong id="chapterCount">—</strong><span>Chapters</span></div><div class="count"><strong id="contentCount">—</strong><span>Saved materials</span></div></div>
<div class="grid">
<section class="card span5" id="studyStructureCard"><div class="sectionhead"><h2>Study structure</h2><span class="pill">Live Supabase data</span></div><p class="subhead">Create, rename, and delete any classes, subjects, and chapters. Nothing is fixed in code; changes appear on the public site after refresh.</p>
<div class="field"><label for="classSelect">Selected class</label><select id="classSelect" onchange="classChanged()"></select></div><div class="fields" style="margin-top:12px"><div class="field"><label for="classLevel">New class number</label><input id="classLevel" type="number" min="1" step="1" placeholder="e.g. 11"></div><div class="field"><label for="className">Display name</label><input id="className" placeholder="Class 11"></div></div><div class="actions"><button class="primary" onclick="addClass()">＋ Add class</button><button onclick="renameClass()">Rename selected</button><button class="danger" onclick="deleteClass()">Delete class</button></div>
<hr style="border:0;border-top:1px solid var(--line);margin:20px 0"><div class="field"><label for="subjectSelect">Selected subject</label><select id="subjectSelect" onchange="subjectChanged()"></select></div><div class="field" style="margin-top:12px"><label for="subjectName">Subject name</label><input id="subjectName" placeholder="e.g. Mathematics"></div><div class="fields" style="margin-top:12px"><div class="field"><label for="subjectEmoji">Icon / emoji</label><input id="subjectEmoji" value="📚" maxlength="12"></div><div class="field" style="display:flex;align-items:end"><button class="primary" style="width:100%" onclick="addSubject()">＋ Add subject</button></div></div><div class="actions"><button onclick="renameSubject()">Rename subject</button><button class="danger" onclick="deleteSubject()">Delete subject</button></div>
<hr style="border:0;border-top:1px solid var(--line);margin:20px 0"><div class="field"><label for="chapterSelect">Selected chapter</label><select id="chapterSelect" onchange="chapterChanged()"></select></div><div class="field" style="margin-top:12px"><label for="chapterName">Chapter name</label><input id="chapterName" placeholder="e.g. Real Numbers"></div><div class="actions"><button class="primary" onclick="addChapter()">＋ Add chapter</button><button onclick="renameChapter()">Rename chapter</button><button class="danger" onclick="deleteChapter()">Delete chapter</button></div><div id="structureStatus" class="status"></div></section>
<section class="card span7"><div class="sectionhead"><h2>Study material &amp; PDF manager</h2><span class="pill">Text + chapter PDF</span></div><p class="subhead">Choose a chapter and material type, edit the content, then save it to Supabase.</p><div class="fields"><div class="field"><label for="contentClass">Class</label><select id="contentClass" onchange="contentClassChanged()"></select></div><div class="field"><label for="contentSubject">Subject</label><select id="contentSubject" onchange="contentSubjectChanged()"></select></div><div class="field"><label for="contentChapter">Chapter</label><select id="contentChapter"></select></div><div class="field"><label for="contentType">Material type</label><select id="contentType" onchange="typeChanged()"><option value="notes">Notes</option><option value="ncert">Questions &amp; Answers</option><option value="schand">Extra Questions &amp; Answers</option><option value="notespdf">Chapter Notes PDF</option></select></div></div><div class="field" style="margin-top:12px"><label for="contentTitle">Title</label><input id="contentTitle" placeholder="Chapter title — Notes"></div><div class="field" id="textEditorField" style="margin-top:12px"><label for="contentBody">Content</label><textarea id="contentBody" class="editor" spellcheck="false" placeholder="Write the material here…"></textarea><div id="editorHint" class="hint">Use headings, numbered lists, and plain text. Your public site will display the saved content.</div></div><div class="field hidden" id="pdfEditorField" style="margin-top:12px"><label for="contentPdf">Upload chapter PDF</label><input id="contentPdf" type="file" accept="application/pdf,.pdf"><div class="hint">Choose a PDF from your device. It will be stored in the SmartHub PDF library and displayed in the chapter page.</div><div id="pdfCurrentStatus" class="status"></div></div><div class="actions"><button onclick="loadContent()">Load saved content</button><button onclick="insertTemplate()">Insert template</button><button class="primary" onclick="saveContent()">Save to Supabase</button><button class="danger" onclick="clearEditor()">Clear editor</button></div><div id="contentStatus" class="status"></div></section>

<section class="card span12" id="suggestionsAdminCard">
  <div class="sectionhead">
    <div><h2>Student suggestions</h2><p class="subhead" style="margin:5px 0 0">Review, edit, hide, restore, or permanently delete suggestions submitted on the public website.</p></div>
    <button onclick="loadAdminSuggestions()">↻ Refresh</button>
  </div>
